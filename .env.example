# ------------------------------------------------------------------
# AI-Powered MIET Jammu Website Chatbot - environment configuration
# Copy this file to ".env" and fill in your own values.
# On Windows (cmd):   copy .env.example .env
# ------------------------------------------------------------------

# API key (REQUIRED for the chatbot to answer any question like a normal AI).
# Without it the bot falls back to a limited MIET-website search only.
OPENAI_API_KEY=

# Optional: use any OpenAI-compatible provider instead of OpenAI, e.g.
#   Groq:   https://api.groq.com/openai/v1      (model: llama-3.3-70b-versatile)
#   Gemini: https://generativelanguage.googleapis.com/v1beta/openai/  (model: gemini-2.0-flash)
# Leave empty for OpenAI itself.
OPENAI_BASE_URL=

# LLM model used when the key above is set.
OPENAI_MODEL=gpt-4o-mini

# Where the SQLite knowledge base is stored.
DATABASE_PATH=data/miet_kb.sqlite3

# Host/port for the FastAPI server.
APP_HOST=127.0.0.1
APP_PORT=8000
