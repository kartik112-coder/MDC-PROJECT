# ------------------------------------------------------------------
# AI-Powered MIET Jammu Website Chatbot - environment configuration
# Copy this file to ".env" and fill in your own values.
# On Windows (cmd):   copy .env.example .env
# ------------------------------------------------------------------

# OpenAI API key (optional but recommended).
# If left empty, the chatbot still works: it answers with an
# extractive, retrieval-grounded mode instead of LLM generation.
OPENAI_API_KEY=

# LLM model used when the key above is set.
OPENAI_MODEL=gpt-4o-mini

# Where the SQLite knowledge base is stored.
DATABASE_PATH=data/miet_kb.sqlite3

# Host/port for the FastAPI server.
APP_HOST=127.0.0.1
APP_PORT=8000
